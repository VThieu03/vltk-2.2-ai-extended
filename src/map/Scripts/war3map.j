b=(hb-1)/ 2exitwhen(fb[Gb]<=Hb)set Db[hb]=Db[Gb]set fb[hb]=fb[Gb]set hb=Gbendloopset fb[hb]=Hbset Db[hb]=ojcall SetUnitUserData(oj,ib[dF])call TimerStart(db,fb[0]-TimerGetElapsed(Cb),false,function ZH)elsecall SetUnitUserData(oj,0)call SetUnitFlyHeight(oj,0,0)call UnitRemoveAbility(oj,ib[dF])endifif(Ab[dF])thencall Hg(dF)endifendfunctionfunction rj takes integer dF,real x,real y returns nothinglocal unit ojif(Vb[dF]<Se)thenset oj=Bbcall SetUnitOwner(oj,Eb[dF],false)elseif(bb>0)thenset bb=bb-1set oj=Nb[bb]call SetUnitOwner(oj,Eb[dF],false)elseset oj=CreateUnit(Eb[dF],'e007',0,0,0)call TriggerRegisterUnitEvent(gb,oj,EVENT_UNIT_SPELL_ENDCAST)call UnitAddAbility(oj,'Aloc')call UnitAddAbility(oj,'Amrf')call UnitRemoveAbility(oj,'Amrf')endifcall UnitAddAbility(oj,ib[dF])call UnitResetCooldown(oj)call SetUnitState(oj,UNIT_STATE_MANA,10000.)if(ab[dF]>1)thencall SetUnitAbilityLevel(oj,ib[dF],ab[dF])endifif(Xb[dF])thencall SetUnitX(oj,Ob[dF])call SetUnitY(oj,Rb[dF])call SetUnitFlyHeight(oj,Ib[dF],.0)elsecall SetUnitX(oj,x)call SetUnitY(oj,y)endifcall IssuePointOrderById(oj,cb[dF],x,y)if(Vb[dF]>=Se)thenset Hb=TimerGetElapsed(Cb)+Vb[dF]set hb=Fbset Fb=Fb+1loopexitwhen(hb==0)set Gb=(hb-1)/ 2exitwhen(fb[Gb]<=Hb)set Db[hb]=Db[Gb]set fb[hb]=fb[Gb]set hb=Gbendloopset fb[hb]=Hbset Db[hb]=ojcall SetUnitUserData(oj,ib[dF])call TimerStart(db,fb[0]-TimerGetElapsed(Cb),false,function ZH)elsecall SetUnitUserData(oj,0)call SetUnitFlyHeight(oj,0,0)call UnitRemoveAbility(oj,ib[dF])endifif(Ab[dF])thencall Hg(dF)endifendfunctionfunction aj takes nothing returns booleanlocal unit u=GetFilterUnit()if IsUnitInRangeXY(u,Jb,kb,Kb)thencall vj(lb,u)endifset u=nullreturn falseendfunctionfunction Vj takes nothing returns booleanlocal unit u=GetTriggerUnit()if(GetUnitUserData(u)!=0)thencall PauseUnit(u,true)endifset u=nullreturn trueendfunctionfunction Ej takes nothing returns nothinglocal integer i=se+1local uni
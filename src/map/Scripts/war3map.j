ns nothingset He=GetEnumUnit()call UnitRemoveAbility(He,'Amov')call UnitAddAbility(He,'Abun')call UnitAddAbility(He,'Asud')call AddUnitToStock(He,'h001',1,1)if 'h01A'>0 thencall AddUnitToStock(He,'h01A',1,1)endifcall SetUnitInvulnerable(He,true)call TriggerRegisterUnitEvent(je,He,EVENT_UNIT_SELL)call TriggerRegisterUnitEvent(Je,He,EVENT_UNIT_ISSUED_TARGET_ORDER)call TriggerRegisterUnitEvent(Je,He,EVENT_UNIT_ISSUED_POINT_ORDER)call TriggerRegisterUnitEvent(Je,He,EVENT_UNIT_ISSUED_ORDER)endfunctionfunction pH takes nothing returns nothinglocal integer i=0local integer j=0local real xlocal real ylocal timer t=nulllocal timerdialog tdset he=GetPlayers()-1call GroupEnumUnitsOfPlayer(Ge,Player($F),Condition(function mH))if IsMapFlagSet(MAP_RANDOM_HERO)thencall KH()returnendifcall TriggerAddAction(je,function lH)call TriggerAddAction(Je,function LH)call ForGroup(Ge,function MH)loopexitwhen i>heset x=GetRectCenterX(Fe[i])set y=GetRectCenterY(Fe[i])call SetPlayerAlliance(Player($F),Player(i),ALLIANCE_SHARED_CONTROL,true)call SetPlayerAlliance(Player($F),Player(i),ALLIANCE_SHARED_VISION,true)if GetLocalPlayer()==Player(i)thencall SetCameraPosition(x,y)endifif false and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i))==MAP_CONTROL_COMPUTER thencall Tg(1,Player(i))endifset i=i+1endloopif 100.>.0 thenset t=CreateTimer()call TimerStart(t,100.,false,null)set td=CreateTimerDialog(t)call TimerDialogSetTitle(td,"Chọn tướng")call TriggerSleepAction(.0)call TimerDialogDisplay(td,true)endifloopset i=0set j=0loopexitwhen i>heif de[i]==null and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and(false or GetPlayerController(Player(i))!=MAP_CONTROL_COMPUTER)thenif t!=null and TimerGetRemaining(t)<=.1 thencall JH(Player(i),true)endifset j=j+1elseif GetLocalPlayer()==Player(i)thencall TimerDialogDisplay(td,false)endifset i=i+1endloopexitwhen j<=0if CountUnitsInGroup(Ge)<=0 thencall BJDebugMsg("HSS Error: |cffff0000There are no more heroes left to select.")exitwhen trueendifcall TriggerSleepAction(.0)endloopif t!=null thencall DestroyTimer(t)call DestroyTimerDialog(td)set t=nullset td=nullendifcall HH()endfunctionfunction PH takes item qH returns integerlocal integer ihif(Le==null)thenif(me>0)thenset me=me-1set Le=Me[me]elseset Le=CreateUnit(Player($F),'e007',0,0,0)endifcall UnitAddAbility(Le,le)call ShowUnit(Le,false)endifif not UnitAddItem(Le,qH)thenreturn 0endifset ih=kg()set WN[ih]=qHset yN[ih]=Leif(UnitInventoryCount(Le)==UnitInventorySize(Le))thenset Le=nullendifreturn ihendfunctionfunction QH takes integer dF returns nothingif(UnitInventoryCount(yN[dF])==UnitInventorySize(yN[dF]))thenset Me[me]=yN[dF]set me=me+1endifcall UnitRemoveItem(yN[dF],WN[dF])endfunctionfunction sH takes integer dF returns nothingif dF==null thenreturnelseif(wN[dF]!=-1)thenreturnendifcall QH(dF)set wN[dF]=uNset uN=dFendfunctionfunction s__ItemHolder_create takes nothing returns integerreturn 0endfunctionfunction tH takes item it returns integerlocal integer dset d=(GetItemUserData(it))if(d==0)thenset d=jg()set eb[d]=itcall SetItemUserData(it,(d))set Pe[qe]=dset qe=qe+1endifreturn(d)endfunctionfunction TH takes nothing returns nothinglocal integer uHlocal integer ilocal integer jif(qe>0)thenset uH=Qe-qe*(Qe/ qe)set i=uHset j=0loopexitwhen(j>=pe)if(GetItemTypeId(eb[Pe[i]])==0)or(GetWidgetLife(eb[Pe[i]])==.0)thenset eb[Pe[i]]=nullcall Jg(Pe[i])set qe=qe-1set Pe[i]=Pe[qe]endifset i=i+1exitwhen(qe==0)if(i>=qe)thenset i=0endifif(uH>=qe)thenset uH=0endifexitwhen(i==uH)set j=j+1endloopset Qe=iendifendfunctionfunction UH takes nothing returns nothinglocal timer T=CreateTimer()call TimerStart(T,2.5,true,function TH)set T=nullendfunctionfunction wH takes integer WH,integer yH,player YH returns integerlocal integer r=hg()if(r==0)thenendifset cb[r]=yHset ib[r]
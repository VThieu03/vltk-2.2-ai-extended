function xh takes nothing returns nothing
local integer i=1
local integer oh=0
local integer rh=0
local integer d=0
local real x=.0
local real y=.0
local real ah=.0
local real nh=.0
loop
exitwhen i>bv
set d=Bv[i]
set oh=aN[d]
set x=GetUnitX(ZA[d])
set y=GetUnitY(ZA[d])
if rN[d]!=.0 then
set Gv[0]=rN[d]>.0
call SetRect(fv,x-rN[d],y-rN[d],x+rN[d],y+rN[d])
call EnumDestructablesInRect(fv,gv,function pG)
endif
if VN[d]then
if MG(x+50.*oN[d],y+50.*xN[d])==false then
set rh=1
if true then
call DestroyEffect(AddSpecialEffect("war3mapImported\\TND_thienngoaistone.mdx",x,y))
endif
endif
endif
if aN[d]==0 then
set aN[d]=SG(ZA[d],"sfx")
else
set aN[d]=SG(ZA[d],"")
endif
if aN[d]==1 and oh==2 then
call DestroyEffect(iN[d])
set iN[d]=AddSpecialEffectTarget("Effect\\KnockbackDust.mdl",ZA[d],"origin")
elseif aN[d]==2 and oh==1 then
call DestroyEffect(iN[d])
set iN[d]=AddSpecialEffectTarget("Effect\\KnockbackWater.mdl",ZA[d],"origin")
endif
if vN[d]<=0 or sG(x,y)or Gv[1]or rh==1 then
call eh(d)
set Bv[i]=Bv[bv]
set bv=bv-1
set i=i-1
set rh=0
else
set ah=x+vN[d]*oN[d]
set nh=y+vN[d]*xN[d]
if nN[d]then
call SetUnitX(ZA[d],ah)
call SetUnitY(ZA[d],nh)
else
call SetUnitPosition(ZA[d],ah,nh)
endif
set vN[d]=vN[d]-eN[d]
endif
set i=i+1
endloop
if bv<=0 then
call PauseTimer(Fv)
set bv=0
endif
endfunction
function Vh takes unit uG,real UG,real wG,real WG,string Eh,real YG,boolean zG,boolean ZG returns boolean
local integer d=0
if uG==null or UG<=.0 or wG<=.0 then
return false
endif
set d=TG(uG,UG,(wG/ .04),(WG*.01745328),Eh,YG,zG,ZG)
set bv=bv+1
if bv==1 then
call TimerStart(Fv,.04,true,function xh)
endif
set Bv[bv]=d
return true
endfunction

function TG takes unit uG,real UG,real wG,real WG,string yG,real YG,boolean zG,boolean ZG returns integer
local integer d=Kg()
set ZA[d]=uG
set vN[d]=(2.*UG)/ wG
set eN[d]=vN[d]/ wG
set xN[d]=Sin(WG)
set oN[d]=Cos(WG)
set rN[d]=YG
set nN[d]=zG
set VN[d]=ZG
set aN[d]=SG(ZA[d],yG)
if aN[d]==0 then
set iN[d]=AddSpecialEffectTarget(yG,ZA[d],"origin")
elseif aN[d]==1 then
set iN[d]=AddSpecialEffectTarget("Effect\\KnockbackDust.mdl",ZA[d],"origin")
elseif aN[d]==2 then
set iN[d]=AddSpecialEffectTarget("Effect\\KnockbackWater.mdl",ZA[d],"origin")
endif
return d
endfunction

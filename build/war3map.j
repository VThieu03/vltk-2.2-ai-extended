function Bt takes nothing returns nothing
local unit c=GetTriggerUnit()
local player p=GetOwningPlayer(c)
local integer i=GetPlayerId(p)+1
local item it=GetOrderTargetItem()
local real x=GetUnitX(c)-GetItemX(it)
local real y=GetUnitY(c)-GetItemY(it)
local real ct=SquareRoot(x*x+y*y)
local real xi=GetUnitX(Er[i])
local real yi=GetUnitY(Er[i])
if GetItemType(it)!=ITEM_TYPE_CHARGED and IsItemSellable(it)and ct<=200. then
if iJ(c)==0 then
call IssueImmediateOrderById(c,$D0004)
call TriggerSleepAction(.1)
if IsItemOwned(it)==false then
call SetItemPosition(it,xi,yi)
call hh(p,GetItemName(it)+" được chuyển về thủ khố")
endif
endif
endif
set c=null
set p=null
set it=null
endfunction

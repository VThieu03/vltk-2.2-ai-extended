local unit kt
set jt='d'
set Gt=0
set ht=0
set Ht=0
set Jt=GetManipulatedItem()
set kt=GetManipulatingUnit()
loop
exitwhen ht>6
if((GetItemTypeId(Jt))==(GetItemTypeId(UnitItemInSlotBJ(kt,ht))))then
if((GetItemCharges(UnitItemInSlotBJ(kt,ht))+GetItemCharges(Jt))<=jt)then
if not((UnitItemInSlotBJ(kt,ht))==(Jt))then
set Ht=(GetItemCharges(UnitItemInSlotBJ(kt,ht)))+GetItemCharges(Jt)
call SetItemCharges(UnitItemInSlotBJ(kt,ht),Ht)
call RemoveItem(Jt)
set ht=7
endif
endif
endif
if(ht<7)then
set ht=ht+1
endif
endloop
set kt=null

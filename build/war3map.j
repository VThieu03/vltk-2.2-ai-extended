endfunction
function Qu takes nothing returns nothing
local unit Sp=GetTriggerUnit()
local player p=GetOwningPlayer(Sp)
local integer ZJ=GetUnitAbilityLevel(Sp,'A0D1')
local real X=GetUnitX(Sp)
local real Y=GetUnitY(Sp)
local unit Dh
local unit oj
local group g=CreateGroup()
local integer ic=40
local integer ir=GetRandomInt(1,'d')
local real tp=((300.*I2R(ZJ))+(4.*I2R(GetHeroStr(Sp,true))))
local real Tp=tp*.6
local real Ju=.25*tp
local real su
if UnitHasItemOfTypeBJ(Sp,'I01H') then
set su=600
else
set su=0
endif
set oj=CreateUnit(p,'h00N',X,Y,.0)
call UnitApplyTimedLife(oj,'BTLF',1.)
call GroupEnumUnitsInRange(g,X,Y,450,Condition(function qu))
loop
set Dh=FirstOfGroup(g)
exitwhen Dh==null

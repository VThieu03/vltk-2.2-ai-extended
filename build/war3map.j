function Ut takes nothing returns boolean
return(IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO))!=null
endfunction
function wt takes nothing returns nothing
local unit u=GetTriggerUnit()
local item i=GetManipulatedItem()
local player p=GetOwningPlayer(u)
if GetItemTypeId(i)=='I00F' then
set pX=zH()
set ib[pX]='A0DP'
set cb[(pX)]=($D0132)
set Eb[pX]=p
call vj(pX,u)
elseif GetItemTypeId(i)=='I00G' then
set pX=wH('A0DQ',vX,p)
call vj(pX,u)
elseif GetItemTypeId(i)=='I00H' then
set pX=wH('A0DR',aX,p)
call vj(pX,u)
elseif GetItemTypeId(i)=='I00I' then
set pX=wH('A0DS',nX,p)
call vj(pX,u)
endif
set u=null
set i=null
set p=null
endfunction
function yt takes nothing returns boolean
return(IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)and GetUnitAbilityLevel(GetTriggerUnit(),'Binv')<=0)!=null
endfunction
function Yt takes nothing returns nothing
local unit u=GetTriggerUnit()
local real LJ=GetUnitState(u,UNIT_STATE_LIFE)
local player p=GetOwningPlayer(u)
if UnitHasItemOfTypeBJ(u,'rst1') and LJ<=.08*GetUnitState(u,UNIT_STATE_MAX_LIFE)and RectContainsUnit(qa,u)!=true then
set PX=wH('A030',nX,p)
call vj(PX,u)
elseif UnitHasItemOfTypeBJ(u,'I020') and LJ<=.1*GetUnitState(u,UNIT_STATE_MAX_LIFE)and RectContainsUnit(qa,u)!=true then
set PX=wH('A030',nX,p)
call vj(PX,u)
elseif UnitHasItemOfTypeBJ(u,'I021') and LJ<=.12*GetUnitState(u,UNIT_STATE_MAX_LIFE)and RectContainsUnit(qa,u)!=true then
set PX=wH('A030',nX,p)
call vj(PX,u)
elseif UnitHasItemOfTypeBJ(u,'I022') and LJ<=.15*GetUnitState(u,UNIT_STATE_MAX_LIFE)and RectContainsUnit(qa,u)!=true then
set PX=wH('A030',nX,p)
call vj(PX,u)
endif
set u=null
set p=null
endfunction

endfunction
function pu takes nothing returns nothing
local unit Sp=GetTriggerUnit()
local unit ej=GetSpellTargetUnit()
local player p=GetOwningPlayer(Sp)
local real X=GetUnitX(ej)
local real Y=GetUnitY(ej)
local integer ZJ=GetUnitAbilityLevel(Sp,'A0AH')
local unit oj
local unit Dh
local group g=CreateGroup()
local real tp=((150.*I2R(ZJ))+(4.*I2R(GetHeroStr(Sp,true))))
local real Tp=tp*.4
set oj=CreateUnit(p,'h00M',X,Y,.0)
call UnitApplyTimedLife(oj,'BTLF',1.5)
call GroupEnumUnitsInRange(g,X,Y,280,Condition(function Mu))
loop
set Dh=FirstOfGroup(g)
exitwhen Dh==null
call GroupRemoveUnit(g,Dh)
if IsUnitInGroup(Dh,Qx) then
call Kh(Dh,p,"+"+I2S(R2I(Tp)),"|c00ffcc00")
call UnitDamageTarget(Sp,Dh,(tp+Tp),false,false,WX,yX,null)
else
call UnitDamageTarget(Sp,Dh,(tp),false,false,WX,yX,null)
endif
endloop
call DestroyGroup(g)
set g=null
set Sp=null
set Dh=null
set oj=null
set p=null
endfunction
function qu takes nothing returns boolean

endif
call SetPlayerAlliance(Player($F),p,ALLIANCE_SHARED_CONTROL,false)
call SetPlayerAlliance(Player($F),p,ALLIANCE_SHARED_VISION,false)
set de[id]=He
if De!=null then
set bj_lastCreatedUnit=He

function uz takes nothing returns nothing
local unit u=GetEnumUnit()
local player p=GetOwningPlayer(u)
local integer i=GetPlayerId(p)+1
local real a=GetRectCenterX(Tr)
local real b=GetRectCenterY(Tr)
set zzVL_logMsg="arena uz"
call ExecuteFunc("zzVL_LogNow")
call UnitResetCooldown(u)
call UnitRemoveBuffs(u,true,true)
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_MAX_LIFE)*RMaxBJ(0,100.)*.01)
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MAX_MANA)*RMaxBJ(0,100.)*.01)
if Jh(jv[i],Jv[i])then
call SetUnitPosition(u,jv[i],Jv[i])
call PanCameraToTimedForPlayer(p,jv[i],Jv[i],.0)
else
call SetUnitPosition(u,a,b)
call PanCameraToTimedForPlayer(p,a,b,.0)
endif
set u=null
set p=null
endfunction

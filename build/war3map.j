function zzVL_InArena takes unit u returns boolean
local real x=GetUnitX(u)
local real y=GetUnitY(u)
return x>8300. and x<10800. and y>-200. and y<6600.
endfunction
function zzVL_ReviveArenaDeadAction takes nothing returns nothing
local unit u=GetEnumUnit()
local player p=GetOwningPlayer(u)
call ReviveHeroLoc(u,GetPlayerStartLocationLoc(p),true)
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_MAX_LIFE))
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MAX_MANA))
call PanCameraToTimedForPlayer(p,GetStartLocationX(GetPlayerStartLocation(p)),GetStartLocationY(GetPlayerStartLocation(p)),.0)
endfunction
function zzVL_ReviveArenaDead takes nothing returns nothing
if zzVL_deadArena!=null then
call ForGroup(zzVL_deadArena,function zzVL_ReviveArenaDeadAction)
call GroupClear(zzVL_deadArena)
endif
endfunction
function zzVL_Drop takes itempool vl_p,real vl_x,real vl_y returns item
local item vl_it
local integer vl_n=0
local integer vl_c
loop
set vl_it=PlaceRandomItem(vl_p,vl_x,vl_y)
if vl_it!=null and zzVL_ht!=null and (LoadInteger(zzVL_ht,GetItemTypeId(vl_it),53)>0 or LoadInteger(zzVL_ht,GetItemTypeId(vl_it),44)>0) then
call RemoveItem(vl_it)
return null
endif
if vl_it==null or zzVL_ht==null or LoadInteger(zzVL_ht,GetItemTypeId(vl_it),0)/10<1 then
return vl_it
endif
set vl_c=LoadInteger(zzVL_ht,GetItemTypeId(vl_it),42)
if vl_c<5 then
call SaveInteger(zzVL_ht,GetItemTypeId(vl_it),42,vl_c+1)
if GetRandomInt(1,100)<=50 then
set vl_c=LoadInteger(zzVL_ht,GetItemTypeId(vl_it),0)
set vl_c=vl_c-(vl_c/10)*10
if zzVL_jw[vl_c*10]!=0 then
call RemoveItem(vl_it)
set vl_it=CreateItem(zzVL_jw[vl_c*10+GetRandomInt(0,5)],vl_x,vl_y)
endif
endif
call SaveInteger(zzVL_ht,GetHandleId(vl_it),73,1)
return vl_it
endif
call RemoveItem(vl_it)
set vl_n=vl_n+1
exitwhen vl_n>=10
endloop
return null
endfunction
function Sf takes real tf returns nothing
local real Tf
local real st=TimerGetElapsed(Lf)
if st<=0 then
set Lf=CreateTimer()
call TimerStart(Lf,$F4240,false,null)
endif
if(tf>0)then
loop
set Tf=tf-TimerGetElapsed(Lf)+st
exitwhen Tf<=0
if(Tf>bj_POLLED_WAIT_SKIP_THRESHOLD)then
call TriggerSleepAction(.1*Tf)
else
call TriggerSleepAction(bj_POLLED_WAIT_INTERVAL)
endif
endloop
endif
endfunction
function uf takes nothing returns boolean
local real dx=GetDestructableX(GetFilterDestructable())-Mf
local real dy=GetDestructableY(GetFilterDestructable())-pf
return(dx*dx+dy*dy<=bj_enumDestructableRadius)
endfunction
function Uf takes rect r,boolexpr wf returns group
set Pf=CreateGroup()
call GroupEnumUnitsInRect(Pf,r,wf)
call DestroyBoolExpr(wf)
return Pf
endfunction
function Wf takes rect r returns group
set Pf=CreateGroup()
call GroupEnumUnitsInRect(Pf,r,Qf)
return Pf
endfunction
function yf takes real Yf,location zf,boolexpr wf returns group
set Pf=CreateGroup()
call GroupEnumUnitsInRangeOfLoc(Pf,zf,Yf,wf)
return Pf
endfunction
function Zf takes player vF,boolexpr wf returns group
set Pf=CreateGroup()
call GroupEnumUnitsOfPlayer(Pf,vF,wf)
call DestroyBoolExpr(wf)
return Pf
endfunction
function eF takes player vF returns force
set qf=CreateForce()
call ForceAddPlayer(qf,vF)
return qf
endfunction
function xF takes player vF returns force
set qf=CreateForce()
call ForceEnumAllies(qf,vF,Qf)
return qf
endfunction
function oF takes boolexpr wf returns force
set qf=CreateForce()
call ForceEnumPlayers(qf,wf)
call DestroyBoolExpr(wf)
return qf
endfunction
function rF takes itemtype iF,integer aF returns nothing
local group g
set bj_stockPickedItemType=iF
set bj_stockPickedItemLevel=aF
set g=CreateGroup()
call GroupEnumUnitsOfType(g,"marketplace",Qf)
call ForGroup(g,function UpdateEachStockBuildingEnum)
call DestroyGroup(g)
set g=null
endfunction
function nF takes nothing returns nothing
local integer pickedItemId
local itemtype VF
local integer EF=0
local integer XF=0
local integer aF
set aF=1
loop
if(bj_stockAllowedPermanent[aF])then
set XF=XF+1
if(GetRandomInt(1,XF)==1)then
set VF=ITEM_TYPE_PERMANENT
set EF=aF
endif
endif
if(bj_stockAllowedCharged[aF])then
set XF=XF+1
if(GetRandomInt(1,XF)==1)then
set VF=ITEM_TYPE_CHARGED
set EF=aF
endif
endif
if(bj_stockAllowedArtifact[aF])then
set XF=XF+1
if(GetRandomInt(1,XF)==1)then
set VF=ITEM_TYPE_ARTIFACT
set EF=aF
endif
endif
set aF=aF+1
exitwhen aF>$A
endloop
if(XF==0)then
set VF=null
return
endif
call rF(VF,EF)
set VF=null
endfunction
function OF takes nothing returns nothing
call nF()
call TimerStart(bj_stockUpdateTimer,bj_STOCK_RESTOCK_INTERVAL,true,function nF)
endfunction
function IF takes nothing returns boolean
return true
endfunction

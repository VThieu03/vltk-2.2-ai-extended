function kL takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local integer ic=GetRandomInt(1,'d')
local real hp=GetUnitState(u,UNIT_STATE_LIFE)
local real KL=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local location lL=GetRandomLocInRect(Ur)
local location LL=GetRandomLocInRect(wr)
local location mL=GetRandomLocInRect(Wr)
local location ML=GetRandomLocInRect(yr)
if IsUnitAlly(u,Player(0))and hp<=(.35*KL)then
call IssuePointOrderByIdLoc(u,$D0012,lL)

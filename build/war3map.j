call UnitAddAbility(u,'Abun')
call UnitAddAbility(u,'Asud')
call AddUnitToStock(u,'h001',1,1)
call AddUnitToStock(u,'h01A',1,1)
call SetUnitInvulnerable(u,true)
call UnitModifySkillPoints(u,-1)
call TriggerRegisterUnitEvent(ke,u,EVENT_UNIT_ISSUED_ORDER)

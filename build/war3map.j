function ju takes nothing returns nothing
local unit u=GetAttacker()
local player p=GetOwningPlayer(u)
local integer ZJ=GetUnitAbilityLevel(u,'A0CY')
local integer ic=$A
local integer ir=GetRandomInt(1,'d')
local real Ju=(ZJ*20)
if ir<=ic then
if GetUnitState(u,UNIT_STATE_LIFE)<GetUnitState(u,UNIT_STATE_MAX_LIFE)then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\FaerieDragonInvis\\FaerieDragon_Invis.mdl",u,"origin"))
call SetUnitState(u,UNIT_STATE_LIFE,RMaxBJ(0,GetUnitState(u,UNIT_STATE_LIFE)+Ju))
call Kh(u,p,"+"+I2S(R2I(Ju)),"|cff00ff00")
endif
endif
set u=null
set p=null
endfunction

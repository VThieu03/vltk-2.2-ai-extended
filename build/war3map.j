endfunction
function vT takes nothing returns nothing
local unit u=GetTriggerUnit()
local real LJ=GetUnitState(u,UNIT_STATE_LIFE)
local real eT=(.05*GetUnitState(u,UNIT_STATE_MAX_LIFE))
local player p=GetOwningPlayer(u)
local integer ic=$A
local integer ir=GetRandomInt(1,'d')
if UnitHasItemOfTypeBJ(u,'hval') and LJ<=GetUnitState(u,UNIT_STATE_MAX_LIFE)and ir<=ic then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\FaerieDragonInvis\\FaerieDragon_Invis.mdl",u,"origin"))
call SetUnitState(u,UNIT_STATE_LIFE,RMaxBJ(0,GetUnitState(u,UNIT_STATE_LIFE)+eT))
call ph(u,"+"+I2S(R2I(eT)),"|cff00ff00")
elseif UnitHasItemOfTypeBJ(u,'I026') and LJ<=GetUnitState(u,UNIT_STATE_MAX_LIFE)and ir<=ic then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\FaerieDragonInvis\\FaerieDragon_Invis.mdl",u,"origin"))
call SetUnitState(u,UNIT_STATE_LIFE,RMaxBJ(0,GetUnitState(u,UNIT_STATE_LIFE)+eT))
call ph(u,"+"+I2S(R2I(eT)),"|cff00ff00")
elseif UnitHasItemOfTypeBJ(u,'I027') and LJ<=GetUnitState(u,UNIT_STATE_MAX_LIFE)and ir<=ic then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\FaerieDragonInvis\\FaerieDragon_Invis.mdl",u,"origin"))
call SetUnitState(u,UNIT_STATE_LIFE,RMaxBJ(0,GetUnitState(u,UNIT_STATE_LIFE)+eT))

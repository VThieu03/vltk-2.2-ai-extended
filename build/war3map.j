function pH takes nothing returns nothing
local integer i=0
local integer j=0
local real x
local real y
local timer t=null
local timerdialog td
set he=GetPlayers()-1
call GroupEnumUnitsOfPlayer(Ge,Player($F),Condition(function mH))
if IsMapFlagSet(MAP_RANDOM_HERO)then
call KH()
return
endif
call TriggerAddAction(je,function lH)
call TriggerAddAction(Je,function LH)
call ForGroup(Ge,function MH)
loop
exitwhen i>he
set x=GetRectCenterX(Fe[i])
set y=GetRectCenterY(Fe[i])
call SetPlayerAlliance(Player($F),Player(i),ALLIANCE_SHARED_CONTROL,true)
call SetPlayerAlliance(Player($F),Player(i),ALLIANCE_SHARED_VISION,true)
if GetLocalPlayer()==Player(i)then
call SetCameraPosition(x,y)
endif
if false and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i))==MAP_CONTROL_COMPUTER then
call Tg(1,Player(i))
endif
set i=i+1
endloop
if 100.>.0 then
set t=CreateTimer()
call TimerStart(t,100.,false,null)
set td=CreateTimerDialog(t)
call TimerDialogSetTitle(td,"Chọn tướng")
call TriggerSleepAction(.0)
call TimerDialogDisplay(td,true)
endif
loop
set i=0
set j=0
loop
exitwhen i>he
if de[i]==null and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and(false or GetPlayerController(Player(i))!=MAP_CONTROL_COMPUTER)then
if t!=null and TimerGetRemaining(t)<=.1 then
call JH(Player(i),true)
endif
set j=j+1
elseif GetLocalPlayer()==Player(i)then
call TimerDialogDisplay(td,false)
endif
set i=i+1
endloop
exitwhen j<=0
if CountUnitsInGroup(Ge)<=0 then
call BJDebugMsg("HSS Error: |cffff0000There are no more heroes left to select.")
exitwhen true
endif
call TriggerSleepAction(.0)
endloop
if t!=null then
call DestroyTimer(t)
call DestroyTimerDialog(td)
set t=null
set td=null
endif
call HH()
endfunction
